{
    "name": "stripyhorse/stripyhorse-php",
    "version": "0.3.0",
    "description": "Zebra/ZPL developer tools: render ZPL to PNG, convert PDFs and images to print-ready ZPL, and drive hosted virtual Zebra printers for testing. Authenticate with an API key via `Authorization: Bearer sh_live_…` or `X-Api-Key`.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://stripyhorse.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Stripy Horse",
            "homepage": "https://stripyhorse.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "StripyHorse\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "StripyHorse\\Test\\" : "test/" }
    }
}
